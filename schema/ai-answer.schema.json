{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarvinWeitz/discovery-agents-test/schema/ai-answer.schema.json",
  "title": "AI answer to one gap",
  "description": "What an AI agent writes to run/ai/answers/<gap id>.json for one request in run/ai/requests/. bin/ai-merge.js accepts a finding only when every evidence file:line exists and its quote is within two lines of it. Docs: docs/walkthrough/12-ai-loop.md",
  "type": "object",
  "required": ["gap", "agent", "status", "answer", "findings"],
  "additionalProperties": false,
  "properties": {
    "gap": { "type": "string", "pattern": "^G-[a-z0-9-]+-[0-9a-f]{10}$" },
    "agent": { "type": "string", "minLength": 2, "description": "Agent name, e.g. gap-resolver." },
    "model": { "type": "string", "description": "Optional: the model that answered (kept in the merge log, not in findings ids)." },
    "status": { "enum": ["answered", "unknown"], "description": "unknown = the code does not show it; say what would (a request, a person)." },
    "answer": { "type": "string", "minLength": 3, "description": "Plain-language answer to the gap's question." },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "statement", "evidence", "confidence"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "statement": { "type": "string", "minLength": 3 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "severity": { "type": "object", "additionalProperties": false, "properties": { "level": { "enum": ["critical", "warning", "info", "good"] }, "impact": { "type": "integer", "minimum": 1, "maximum": 5 }, "likelihood": { "type": "integer", "minimum": 1, "maximum": 5 } } },
          "layer": { "type": "string" },
          "test": { "type": "string" },
          "subjects": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["file", "line", "quote"], "additionalProperties": false, "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "quote": { "type": "string", "minLength": 8 } } }
          }
        }
      }
    }
  }
}
