{
  "name": "discovery-db-app",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic fixture for the test database switch (docs/test-database.md): a parameterized HANA-only view, roles, and a Postgres profile",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "scripts": {
    "test:db:before": "node -e \"console.log('before hook ran with CDS_ENV=' + process.env.CDS_ENV)\""
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": { "password": "", "roles": ["Reader"] },
          "admin": { "password": "", "roles": ["Admin"] }
        }
      },
      "[pg]": {
        "db": {
          "kind": "postgres",
          "credentials": { "host": "localhost", "port": 5432, "user": "postgres", "password": "postgres", "database": "discovery" }
        }
      },
      "[file]": {
        "db": { "kind": "sqlite", "credentials": { "url": "db-test.sqlite" } }
      }
    }
  }
}
