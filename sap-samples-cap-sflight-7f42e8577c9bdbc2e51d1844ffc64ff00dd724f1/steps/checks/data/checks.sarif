      "method": "static",
      "status": "suspected",
      "confidence": "medium",
      "layer": "Service"
     }
    },
    {
     "ruleId": "agent-risk",
     "level": "note",
     "message": {
      "text": "deductDiscount 404 path crashes. When the travel is gone, the error message reads travel.ID from undefined: a TypeError and a 500 instead of a 404."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
