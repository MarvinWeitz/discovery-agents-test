     "ruleId": "action-without-handler",
     "level": "warning",
     "message": {
      "text": "createTravelByTemplate: no handler found. Bound action createTravelByTemplate has no srv.on handler the parser can see; CAP answers 501 unless something registers one at runtime."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "srv/travel-service.cds"
        },
        "region": {
         "startLine": 12
        }
