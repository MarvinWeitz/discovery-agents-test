    },
    {
     "ruleId": "agent-risk",
     "level": "note",
     "message": {
      "text": "TravelID = max + 1 race. max(TravelID) is read and incremented on CREATE. Two parallel activations can get the same ID."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
